{
  "name": "@3sln/js-tools",
  "version": "0.1.0",
  "description": "Content-addressed builder and dev server for unbundled ES module applications.",
  "type": "module",
  "author": "Ray Stubbs",
  "repository": {
    "type": "git",
    "url": "https://github.com/3sln/js-tools.git"
  },
  "license": "MIT",
  "keywords": [
    "build",
    "esbuild",
    "import-map",
    "content-addressed",
    "dev-server",
    "hmr",
    "esm"
  ],
  "exports": {
    ".": "./index.js",
    "./build": "./src/build.js",
    "./dev-server": "./src/dev/server.js",
    "./config": "./src/config.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "3sln-build": "./bin/build.js",
    "3sln-dev": "./bin/dev.js"
  },
  "files": [
    "index.js",
    "src/",
    "bin/"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "format": "prettier -w \"src/**/*.js\" \"bin/**/*.js\" \"*.js\""
  },
  "dependencies": {
    "@web/dev-server": "^0.4.6",
    "@web/dev-server-hmr": "^0.1.4",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "engines": {
    "node": ">=20"
  }
}
